# PostgreSQL connection string — required, the app cannot boot without it.
# This value matches the local dev database in compose.yml (`docker compose up -d`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/company_lookup

# Zefix API credentials
ZEFIX_USERNAME=
ZEFIX_PASSWORD=
ZEFIX_API_BASE_URL=https://www.zefix.admin.ch/ZefixPublicREST
